# Copy to infra/.env and replace placeholders before first deploy.
# Never commit infra/.env.

POSTGRES_USER=operator_waw
POSTGRES_PASSWORD=change_me_use_openssl_rand_hex_32
POSTGRES_DB=warszawasza_prod

NEXT_PUBLIC_API_URL=https://warszawasza.online

# Studio-only flacon forge (min 16 chars). Required for POST /api/market/forge.
FLACON_FORGE_ADMIN_SECRET=change_me_min_16_chars

# Host port published for Next.js (nginx proxies to this).
WEB_HOST_PORT=3000
